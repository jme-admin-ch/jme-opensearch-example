<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jme-opensearch-example</artifactId>
        <version>1.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>jme-opensearch-inspection-service</artifactId>
    <name>${project.artifactId}</name>
    <description>Example service providing authorization-aware searches over indexed SearchItems.</description>

    <properties>
        <opensearch-testcontainers.version>2.1.3</opensearch-testcontainers.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-opensearch-client-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-security-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-swagger-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-monitoring-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.admin.bit.jeap.jme.indextype.jme</groupId>
            <artifactId>jme-transit-decision-v1</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap.jme.indextype.jme</groupId>
            <artifactId>jme-transit-decision-v2</artifactId>
            <version>2.0</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap.jme.indextype.jme</groupId>
            <artifactId>jme-transit-document-v1</artifactId>
            <version>1.3</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap.jme.indextype.jme</groupId>
            <artifactId>jme-decree-document-v1</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap.jme.indextype.jme</groupId>
            <artifactId>jme-decree-v1</artifactId>
            <version>1.0</version>
        </dependency>
        <!-- TEST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-spring-boot-security-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch-testcontainers</artifactId>
            <version>${opensearch-testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>ch.admin.bit.jme.opensearch.inspection.InspectionApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>spring-boot</id>
                        <goals><goal>build-info</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
